page {
    background: #F5F7FA;
    font-family: -apple-system, BlinkMacSystemFont, 'Microsoft YaHei', sans-serif;
    color: #333;
    line-height: 1.6;
}

.container {
    padding: 30rpx;
}

.card {
    background: white;
    border-radius: 16rpx;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
    padding: 40rpx;
    margin-bottom: 30rpx;
}

.card-title {
    color: #2C3E50;
    font-size: 34rpx;
    font-weight: bold;
    margin-bottom: 30rpx;
    padding-bottom: 20rpx;
    border-bottom: 1rpx solid #EEE;
}

.form-group {
    margin-bottom: 30rpx;
}

.form-group text {
    display: block;
    color: #555;
    font-size: 28rpx;
    margin-bottom: 12rpx;
    font-weight: 500;
}

.picker {
    background: #F8F9FA;
    padding: 20rpx;
    border-radius: 8rpx;
    border: 1rpx solid #DDD;
    font-size: 30rpx;
}

input {
    width: 100%;
    padding: 20rpx;
    border: 1rpx solid #DDD;
    border-radius: 8rpx;
    font-size: 30rpx;
    background: #F8F9FA;
}

button[type="primary"] {
    width: 100%;
    background: #3498DB;
    color: white;
    border: none;
    border-radius: 8rpx;
    padding: 24rpx;
    font-size: 32rpx;
    margin-top: 30rpx;
}

button[type="primary"]:active {
    background: #2980B9;
}

.no-data {
    text-align: center;
    color: #999;
    padding: 60rpx 0;
    font-size: 28rpx;
}
