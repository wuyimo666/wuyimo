.header {
    background: #2C3E50;
    color: white;
    padding: 20rpx;
    text-align: center;
}

.title {
    font-size: 36rpx;
    font-weight: bold;
}

.data-card {
    display: flex;
    justify-content: space-around;
    background: white;
    margin: 20rpx;
    padding: 30rpx 20rpx;
    border-radius: 12rpx;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.data-item {
    text-align: center;
}

.data-label {
    display: block;
    color: #666;
    font-size: 28rpx;
    margin-bottom: 10rpx;
}

.data-value {
    display: block;
    font-size: 40rpx;
    font-weight: bold;
    color: #2C3E50;
}

.debt-card {
    background: white;
    margin: 20rpx;
    padding: 30rpx;
    border-radius: 12rpx;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.card-title {
    color: #2C3E50;
    font-size: 32rpx;
    font-weight: bold;
    margin-bottom: 20rpx;
    padding-bottom: 15rpx;
    border-bottom: 1rpx solid #EEE;
}

.debt-item {
    display: flex;
    justify-content: space-between;
    padding: 20rpx 0;
    border-bottom: 1rpx solid #F5F5F5;
}

.debt-amount {
    color: #E74C3C;
    font-weight: bold;
}

.no-data {
    text-align: center;
    color: #999;
    padding: 40rpx 0;
}

.view-all {
    display: block;
    text-align: center;
    margin-top: 30rpx;
    color: #3498DB;
    font-size: 28rpx;
}
