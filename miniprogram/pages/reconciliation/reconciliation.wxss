.card {
    background: white;
    margin: 30rpx;
    padding: 40rpx;
    border-radius: 16rpx;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.card-title {
    color: #2C3E50;
    font-size: 34rpx;
    font-weight: bold;
    margin-bottom: 30rpx;
    padding-bottom: 20rpx;
    border-bottom: 1rpx solid #EEE;
}

.picker {
    background: #F8F9FA;
    padding: 20rpx;
    border-radius: 8rpx;
    border: 1rpx solid #DDD;
    font-size: 30rpx;
    color: #333;
}

.debt-summary {
    margin-top: 30rpx;
}

.debt-item {
    display: flex;
    justify-content: space-between;
    padding: 20rpx 0;
    border-bottom: 1rpx solid #F5F5F5;
}

.debt-item .label {
    color: #666;
    font-size: 28rpx;
}

.debt-item .value {
    font-size: 32rpx;
    font-weight: bold;
    color: #2C3E50;
}

.debt-positive {
    color: #E74C3C;
}

.debt-zero {
    color: #27AE60;
}

.section-title {
    margin-top: 40rpx;
    margin-bottom: 20rpx;
    color: #2C3E50;
    font-size: 32rpx;
    font-weight: bold;
}

.table {
    margin-top: 20rpx;
}

.table-header {
    display: flex;
    background: #F8F9FA;
    padding: 20rpx 10rpx;
    border-radius: 8rpx 8rpx 0 0;
    font-weight: 500;
    color: #555;
    font-size: 26rpx;
}

.table-row {
    display: flex;
    padding: 20rpx 10rpx;
    border-bottom: 1rpx solid #F5F5F5;
    font-size: 26rpx;
}

.col-date { width: 20%; }
.col-name { width: 20%; }
.col-prod { width: 25%; }
.col-qty { width: 10%; }
.col-price { width: 15%; }
.col-total { width: 10%; }

.actions {
    display: flex;
    justify-content: space-around;
    margin-top: 40rpx;
}

.actions button {
    width: 45%;
    padding: 24rpx;
    border-radius: 8rpx;
    font-size: 30rpx;
}

button:first-child {
    background: #3498DB;
    color: white;
}

button:last-child {
    background: #27AE60;
    color: white;
}

.no-data {
    text-align: center;
    color: #999;
    padding: 60rpx 0;
    font-size: 28rpx;
}
