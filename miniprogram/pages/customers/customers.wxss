.card {
    background: white;
    margin: 30rpx;
    padding: 40rpx;
    border-radius: 16rpx;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.card-title {
    color: #2C3E50;
    font-size: 34rpx;
    font-weight: bold;
    margin-bottom: 30rpx;
    padding-bottom: 20rpx;
    border-bottom: 1rpx solid #EEE;
}

.form-group {
    margin-bottom: 30rpx;
}

.form-group text {
    display: block;
    color: #555;
    font-size: 28rpx;
    margin-bottom: 12rpx;
    font-weight: 500;
}

input {
    width: 100%;
    padding: 20rpx;
    border: 1rpx solid #DDD;
    border-radius: 8rpx;
    font-size: 30rpx;
    background: #F8F9FA;
}

button[type="primary"] {
    width: 100%;
    background: #3498DB;
    color: white;
    border: none;
    border-radius: 8rpx;
    padding: 24rpx;
    font-size: 32rpx;
    margin-top: 30rpx;
}

.customer-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 0;
    border-bottom: 1rpx solid #F5F5F5;
}

.customer-info {
    flex: 1;
}

.customer-name {
    display: block;
    font-size: 30rpx;
    color: #333;
    margin-bottom: 8rpx;
}

.customer-contact {
    display: block;
    font-size: 26rpx;
    color: #888;
}

.customer-amount {
    font-size: 30rpx;
    font-weight: bold;
    margin-right: 20rpx;
}

.debt-positive {
    color: #E74C3C;
}

.debt-zero {
    color: #27AE60;
}

.btn-small {
    background: #3498DB;
    color: white;
    padding: 10rpx 20rpx;
    border-radius: 8rpx;
    font-size: 26rpx;
    text-decoration: none;
}

.no-data {
    text-align: center;
    color: #999;
    padding: 60rpx 0;
    font-size: 28rpx;
}
